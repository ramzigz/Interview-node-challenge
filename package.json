{
  "name": "reservations-app-api",
  "version": "0.1.0",
  "description": "reservations-app",
  "license": "MIT",
  "author": "RamziGz",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "build": "babel server.js --out-file server.js && babel src --out-dir src",
    "lint": "eslint source/ --quiet",
    "start": "npm run build && node server.js",
    "start:local": "nodemon --exec babel-node server.js",
    "start:debug": "node --inspect server.js",
    "test": "mocha ./tests/*.test.js",
    "validate": "npm run lint; npm run test && npm outdated --depth 0"
  },
  "dependencies": {
    "@hapi/joi-date": "^2.0.1",
    "body-parser": "^1.20.0",
    "compression": "^1.7.4",
    "connect-flash": "^0.1.1",
    "cors": "^2.8.5",
    "dotenv": "^15.0.0",
    "express": "^4.17.2",
    "express-boom": "^3.0.0",
    "express-validation": "^3.0.8",
    "fs": "^0.0.1-security",
    "helmet": "^5.0.2",
    "joi": "^17.6.0",
    "mocha": "^10.0.0",
    "module-alias": "^2.2.2",
    "moment": "^2.29.1",
    "nodemailer": "^6.7.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.16.8",
    "@babel/core": "^7.16.12",
    "@babel/node": "^7.16.8",
    "@babel/plugin-transform-runtime": "^7.16.10",
    "@babel/preset-env": "^7.16.11",
    "chai": "^4.3.6",
    "eslint": "^8.16.0",
    "nodemon": "^2.0.15",
    "sinon": "^13.0.0",
    "supertest": "^6.2.4"
  },
  "_moduleAliases": {
    "@root": ".",
    "@middlewares": "src/middlewares"
  },
  "engines": {
    "node": ">=10.23.1",
    "npm": ">=6.14.10"
  }
}
